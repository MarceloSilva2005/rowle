{
  "name": "rowle",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build -w @rowle/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/core/src/database.types.ts",
    "test:e2e": "npm run test:e2e -w @rowle/web",
    "test:maestro": "bash apps/mobile/maestro/run.sh"
  },
  "devDependencies": {
    "supabase": "^2.121.0"
  }
}
